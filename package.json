{
  "name": "blocks.system",
  "version": "0.4.2",
  "private": true,
  "description": "A small, dependency-free browser system for individually addressable HTML, canvas and custom objects.",
  "type": "module",
  "types": "./blocks.system.d.ts",
  "exports": {
    ".": {
      "types": "./blocks.system.d.ts",
      "default": "./blocks.system.mjs"
    },
    "./min": {
      "types": "./blocks.system.d.ts",
      "default": "./blocks.system.min.mjs"
    },
    "./style": "./blocks.system.css",
    "./storage": {
      "types": "./blocks.storage.d.ts",
      "default": "./blocks.storage.mjs"
    },
    "./storage/min": {
      "types": "./blocks.storage.d.ts",
      "default": "./blocks.storage.min.mjs"
    }
  },
  "files": [
    "blocks.system.mjs",
    "blocks.system.min.mjs",
    "blocks.system.css",
    "blocks.system.d.ts",
    "blocks.storage.mjs",
    "blocks.storage.min.mjs",
    "blocks.storage.d.ts"
  ],
  "scripts": {
    "build:min": "terser blocks.system.mjs --module --compress --mangle --output blocks.system.min.mjs && terser blocks.storage.mjs --module --compress --mangle --output blocks.storage.min.mjs",
    "test": "node tests/contract.mjs && node tests/storage.mjs && node tests/site.mjs && npm run test:types && npm run test:docs-contract && node tests/browser-harness.mjs && node tests/menu-copy.mjs && node tests/browser-layout.mjs && node tests/docs-layout.mjs",
    "test:types": "tsc --project tests/types/tsconfig.node16.json && tsc --project tests/types/tsconfig.bundler.json",
    "test:docs-contract": "node tests/docs-api-contract.mjs",
    "test:presentation": "node tests/site-presentation.mjs",
    "check": "npm run build:min && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-prjcts-be/blocks.system.git"
  },
  "homepage": "https://seb-prjcts-be.github.io/blocks.system/",
  "keywords": [
    "blocks",
    "canvas",
    "custom-elements",
    "dom",
    "esm",
    "grid"
  ],
  "license": "MIT",
  "devDependencies": {
    "terser": "5.49.0",
    "typescript": "7.0.2"
  }
}
