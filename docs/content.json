        "blocks.colorArray = [\"cyan\", \"magenta\", \"yellow\"];",
        "",
        "blocks.colorVariation = 0;     // 0, .5 or 1",
        "blocks.inversionVariation = 0; // 0, .5 or 1"
      ],
      "layout": {
        "place": [3, 42],
        "span": [4, 2]
