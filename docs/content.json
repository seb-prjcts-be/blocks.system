    "manual-compact": {
      "title": "05 / compact after changes",
      "intro": "Use compact() after removing or moving fixed blocks when you want the placed grid to close vertical gaps. It moves fixed blocks upward inside their columns; it does not resize the grid.",
      "contract": "api.html#system-methods",
      "layout": {
        "place": [1, 30],
        "span": [2, 2]
      }
    },
    "manual-compact-code": {
      "title": "compact code",
      "code": [
        "const first = blocks.add(content, { title: \"first\" });",
        "const second = blocks.add(content, { title: \"second\" });",
        "",
        "first.place(1, 1);",
        "second.place(1, 4);",
        "",
        "first.remove();",
        "blocks.compact();"
      ],
      "layout": {
        "place": [3, 30],
        "span": [4, 2]
      }
    },
    "manual-appearance": {
      "title": "06 / choose an appearance",
      "intro": "Choose one fixed monochrome variant. Regular uses dark ink on paper; inverse exchanges figure and ground. Color and chance come later.",
      "contract": "api.html#add-options",
      "layout": {
        "place": [1, 33],
        "span": [2, 1]
      }
    },
    "manual-appearance-code": {
      "title": "appearance code",
      "code": [
        "blocks.add(content, { variant: \"regular\" });",
        "blocks.add(content, { variant: \"inverse\" });"
      ],
      "layout": {
        "place": [3, 33],
        "span": [4, 1]
      }
    },
    "manual-appearance-regular": {
      "title": "regular",
      "eyebrow": "your content",
