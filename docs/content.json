    "manual-random": {
      "title": "08 / set the chance",
      "intro": "Chance affects only future blocks added with the random variant. The three left cells change the color share; the three right cells change the inverse share of the monochrome remainder. Values run from 0 to 1.",
      "contract": "api.html#system-state",
      "layout": {
        "place": [1, 42],
        "span": [2, 2]
      }
    },
    "manual-random-code": {
      "title": "chance code",
      "code": [
