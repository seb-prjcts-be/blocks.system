      "body": "minimize: false · close: false"
    },
    "manual-layout": {
      "title": "04 / size and position",
      "intro": "span() and place() use columns before rows; grid coordinates start at 1. flow() restores automatic placement.",
      "code": [
        "block.span(4, 2);",
        "block.place(1, 1);",
        "",
        "block.flow();"
      ]
    },
