    "manual-colors": {
      "title": "05 / add your colors",
      "intro": "Set these values before blocks.add(). At 1, every new random block uses one supplied color for its border and titlebar; its content stays neutral.",
      "code": [
        "blocks.colorArray = [\"cyan\", \"magenta\", \"yellow\"];",
        "blocks.colorVariation = 1;",
        "blocks.variant = \"random\";"
      ]
    },
