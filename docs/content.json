    "manual-menu": {
      "title": "03 / menu actions",
      "intro": "Set both actions once in blockDefaults. Override only the two booleans on a block when that difference is part of the example.",
      "code": [
        "menu: { minimize: true, close: true }",
        "menu: { minimize: true, close: false }",
        "menu: { minimize: false, close: true }",
        "menu: { minimize: false, close: false }"
      ]
    },
    "manual-menu-both": {
      "title": "menu / both on",
      "eyebrow": "menu options",
      "statement": "Both on.",
      "body": "minimize: true · close: true"
