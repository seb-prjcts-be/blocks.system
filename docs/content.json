  "manual": {
    "manual-eli10": {
      "title": "00 / ELI10",
      "contract": "api.html#exports"
    },
    "manual-start-a": {
      "title": "01 / set up the CDN",
      "body": "Start by loading the latest release. The CDN brings the library's stylesheet and JavaScript module into your page.",
      "code": [
        "https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.3.0/blocks.system.css",
        "https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.3.0/blocks.system.mjs"
      ],
      "contract": "api.html#system-methods",
      "layout": {
        "place": [1, 4],
        "span": [6, 1]
      }
    },
    "manual-start-div": {
      "title": "div",
      "body": "Add an empty div to your HTML. This is the field where the blocks will appear.",
      "layout": {
        "place": [1, 5],
        "span": [2, 1]
      }
    },
    "manual-start-blocks": {
      "title": "blocks",
      "body": "Create the system and attach it to that div. From then on, blocks controls the field.",
      "layout": {
        "place": [1, 6],
        "span": [2, 1]
      }
    },
    "manual-start-grid": {
      "title": "grid",
      "body": "Set the field to a 4 × 4 grid before adding content. That gives you four columns and four rows.",
      "layout": {
        "place": [1, 7],
        "span": [2, 1]
      }
    },
    "manual-start-b": {
      "title": "setup code",
      "code": [
        "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.3.0/blocks.system.css\">",
        "<div id=\"blocks-field\"></div>",
        "",
        "<script type=\"module\">",
        "import { createBlocksSystem } from \"https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.3.0/blocks.system.mjs\";",
        "",
        "const blocks = createBlocksSystem({",
        "  snap: true,",
        "  variant: \"regular\",",
        "  blockDefaults: {",
        "    menu: { minimize: true, close: true }",
        "  }",
        "});",
        "",
        "blocks.attach(\"#blocks-field\");",
        "blocks.setGrid(4, 4);",
        "",
        "const block = blocks.add(\"Hello.\");",
        "block.span(4, 2);",
        "block.place(1, 1);",
        "</script>"
      ],
      "layout": {
        "place": [3, 5],
        "span": [4, 4]
      }
    },
    "manual-finish": {
      "title": "02 / content can be anything",
      "statement": "A block can hold anything the browser can render.",
      "contract": "api.html#add-options",
      "layout": {
        "place": [1, 10],
        "span": [6, 2]
      }
    },
    "manual-content-html-intro": {
      "title": "HTML",
      "intro": "Pass an HTML string to use markup as the block's content.",
      "layout": {
        "place": [1, 12],
        "span": [1, 2]
      }
    },
    "manual-content-html-code": {
      "title": "code",
      "code": [
        "const html = `",
        "  <article>",
        "    <small>01 / statement</small>",
        "    <strong>Structure makes movement visible.</strong>",
        "    <span>type · interval · contrast</span>",
        "  </article>",
        "`;",
        "",
        "blocks.add(html, {",
        "  id: \"block-html\",",
        "  title: \"HTML\"",
        "});"
      ],
      "layout": {
        "place": [2, 12],
        "span": [2, 2]
      }
    },
    "manual-content-html": {
      "title": "result",
      "eyebrow": "01 / statement",
      "statement": "Structure makes movement visible.",
      "footer": "type · interval · contrast",
      "layout": {
        "place": [4, 12],
        "span": [3, 2]
      }
    },
    "manual-content-object-intro": {
      "title": "element object",
      "intro": "Use a browser element for text, images, SVG, canvas, forms or media. For untrusted text, set textContent.",
      "layout": {
        "place": [1, 14],
        "span": [1, 2]
      }
    },
    "manual-content-object-code": {
      "title": "code",
      "code": [
        "const image = document.createElement(\"img\");",
        "image.src = \"./image.jpg\";",
        "image.alt = \"Describe the image.\";",
        "",
        "blocks.add(image, {",
        "  id: \"block-image\",",
        "  title: \"image\"",
        "});"
      ],
      "layout": {
        "place": [2, 14],
        "span": [2, 2]
      }
    },
    "manual-content-object": {
      "title": "result",
      "caption": "02 / direction",
      "alt": "Black-and-white skatepark with converging concrete ramps, painted lines and a metal rail.",
      "layout": {
        "place": [4, 14],
        "span": [3, 2]
      }
    },
    "manual-content-factory-intro": {
      "title": "factory",
      "intro": "Use a function when every added block needs a fresh element and its own interaction.",
      "layout": {
        "place": [1, 16],
        "span": [1, 2]
      }
    },
    "manual-content-factory-code": {
      "title": "code",
      "code": [
        "const factory = () => {",
        "  const button = document.createElement(\"button\");",
        "  button.textContent = \"next state\";",
        "  return button;",
        "};",
        "",
        "blocks.add(factory, {",
        "  id: \"block-button\",",
        "  title: \"interactive\"",
        "});"
      ],
      "layout": {
        "place": [2, 16],
        "span": [2, 2]
      }
    },
    "manual-content-factory": {
      "title": "result",
      "eyebrow": "03 / live",
      "states": ["structure", "contrast", "rhythm", "space"],
      "action": "next state",
      "layout": {
        "place": [4, 16],
        "span": [3, 2]
      }
    },
    "manual-menu": {
      "title": "03 / menu actions",
      "intro": "The titlebar can show minimize, close, both or neither. The four blocks below are the complete on/off set. A controller can also minimize, restore or remove its own block. Close removes this example; reload the page to restore the full manual.",
      "contract": "api.html#block-methods",
      "layout": {
        "place": [1, 19],
        "span": [2, 2]
      }
    },
    "manual-menu-code": {
      "title": "menu code",
      "code": [
        "const block = blocks.add(content, {",
        "  menu: { minimize: true, close: true },",
        "  minimized: false",
        "});",
        "",
        "block.menu(\"hello\", { minimize: true, close: true });",
        "block.minimized = true;  // minimize",
        "block.minimized = false; // restore",
        "block.remove();           // close"
      ],
      "layout": {
        "place": [3, 19],
        "span": [4, 2]
      }
    },
    "manual-menu-both": {
      "title": "minimize + close",
      "eyebrow": "menu options",
      "statement": "Both on.",
      "body": "minimize: true · close: true"
    },
    "manual-menu-minimize": {
      "title": "minimize",
      "eyebrow": "menu options",
      "statement": "Minimize only.",
      "body": "minimize: true · close: false"
    },
    "manual-menu-close": {
      "title": "close",
      "eyebrow": "menu options",
      "statement": "Close only.",
      "body": "minimize: false · close: true"
    },
    "manual-menu-none": {
      "title": "neither",
      "eyebrow": "menu options",
      "statement": "Both off.",
      "body": "minimize: false · close: false"
    },
    "manual-layout": {
      "title": "block size and position",
      "intro": "Set size first, then position. Columns come before rows and coordinates start at 1.",
      "contract": "api.html#block-methods",
      "layout": {
