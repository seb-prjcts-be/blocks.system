  "reference": {
    "reference-system-create": {
      "title": "create a system + options",
      "intro": "Import a factory for an independent system, or use the shared system export. All creation options are optional; their initial values follow.",
      "headers": ["member or option", "returns or initial value", "purpose"],
      "rows": [
        { "id": "api-create", "cells": ["createBlocksSystem(options?)", "BlocksSystem", "Create an independent blocks system."] },
        { "id": "api-system", "cells": ["system", "BlocksSystem", "The shared module instance."] },
        { "id": "api-window", "cells": ["window.blocks.system", "BlocksSystem", "The same shared instance exposed in a browser."] },
        { "cells": ["catalogUrl", "null", "Base URL used by address() when a block has no url of its own."] },
        { "cells": ["random", "Math.random", "Source used when variant is random."] },
        { "cells": ["snap", "false", "Snap blocks to the configured grid."] },
        { "cells": ["draggable", "true", "Allow pointer and keyboard reordering."] },
        { "cells": ["font", "null", "Optional font family and stylesheet URL through family and href."] },
        { "cells": ["labels", "document language", "Override accessible move, restore, minimize and close labels."] },
        { "cells": ["variant", "random", "Appearance used for new blocks."] },
        { "cells": ["colorArray", "[]", "User-owned CSS colors; defaults to empty."] },
        { "cells": ["colorVariation", "0", "Share of random blocks that use colorArray."] },
        { "cells": ["inversionVariation", "1 / 3", "Inverse share inside the remaining monochrome range."] },
        { "cells": ["blockDefaults", "no menu", "Shared menu settings for new blocks."] },
        { "cells": ["blocks", "[]", "Definitions registered during creation."] }
      ]
    },
    "reference-system-state": {
      "title": "system state + properties",
      "headers": ["member", "type", "notes"],
      "rows": [
        { "cells": ["columns", "readonly number", "Current number of grid columns; starts at 1 and changes through setGrid()."] },
        { "cells": ["rows", "readonly number", "Current number of grid rows; starts at 1 and may also grow after dragging."] },
        { "cells": ["snap", "boolean", "Readable and writable. Set snap true before relying on place(), span() or compact() for visual grid layout; snap false keeps blocks in flow layout."] },
        { "cells": ["draggable", "boolean", "Readable and writable."] },
        { "cells": ["font", "object | null", "Readable and writable."] },
        { "cells": ["variant", "string", "Readable and writable; built-in variants are regular and inverse, plus random selection."] },
        { "cells": ["variants", "readonly string[]", "The built-in list: regular and inverse."] },
        { "cells": ["colorArray", "readonly string[]", "User-owned CSS colors for future random blocks."] },
        { "cells": ["colorVariation", "number", "From 0 to 1; a positive value needs a non-empty colorArray."] },
        { "cells": ["inversionVariation", "number", "From 0 to 1."] },
        { "cells": ["labels", "readonly object", "Resolved accessible labels."] },
        { "cells": ["field", "Element | null", "The currently attached field."] }
      ]
    },
    "reference-system-methods": {
      "title": "system methods",
      "headers": ["method", "returns", "purpose"],
      "rows": [
        { "id": "api-attach", "cells": ["attach(target)", "blocks", "Attach to a selector or Element."] },
        { "id": "api-set-grid", "cells": ["setGrid(columns, rows)", "blocks", "Set positive whole grid dimensions."] },
        { "id": "api-compact", "cells": ["compact()", "blocks", "Move fixed grid blocks upward to fill vertical gaps."] },
        { "id": "api-add", "cells": ["add(content, options?)", "block", "Add trusted HTML, an element object or a content factory. Never pass untrusted text as HTML; create an element and set textContent."] },
        { "id": "api-address", "cells": ["address(id)", "string", "Build a deep link ending in ?block=id from the block url, or from the catalogUrl when the definition has none."] }
      ]
    },
    "reference-system-errors": {
      "title": "failures + boundaries",
      "eyebrow": "fail early",
      "statement": "Invalid input throws.",
      "details": "Expect errors for invalid or duplicate ids, missing fields, impossible grid positions, overlaps, unknown definitions, incomplete adapters and colorVariation without colors. Catch only errors your interface can recover from."
    },
    "reference-block-options": {
      "title": "create a block + options",
      "intro": "id identifies a block. title is only optional visible text in its menu bar.",
      "headers": ["option", "type", "purpose"],
      "rows": [
        { "cells": ["id", "string", "Stable id; generated when omitted."] },
        { "cells": ["title", "string", "Optional visible menu text. When omitted, no id is shown; id remains the accessible fallback for menu actions."] },
        { "cells": ["menu", "boolean | object", "Enable, disable or configure a menu for this block."] },
        { "cells": ["variant", "string", "Override the system appearance for this block."] },
        { "cells": ["minimized", "boolean", "Initial minimized state."] },
        { "cells": ["menu.close", "boolean", "Show a remove button."] },
        { "cells": ["menu.minimize", "boolean", "Show a minimize and restore button."] }
      ]
    },
    "reference-block-properties": {
      "title": "block properties",
      "intro": "add() returns one controller for one block.",
      "headers": ["member", "type", "purpose"],
      "rows": [
        { "cells": ["id", "readonly string", "Stable lowercase kebab-case id."] },
        { "cells": ["element", "readonly HTMLElement", "The outer block element. Do not call element.remove(); use remove() so the system releases its layout."] },
        { "cells": ["content", "readonly HTMLDivElement", "The content host inside the block."] },
        { "cells": ["color", "string", "Read or set its CSS color."] },
        { "cells": ["variant", "string", "Read or set its resolved appearance."] },
        { "cells": ["minimized", "boolean", "Read or set its minimized state."] }
      ]
    },
    "reference-block-methods": {
      "title": "block methods",
      "headers": ["method", "returns", "purpose"],
      "rows": [
        { "id": "api-menu", "cells": ["menu(name, options?)", "block", "Add or update the title bar."] },
        { "id": "api-span", "cells": ["span(columns, rows)", "block", "Set the size in whole grid units."] },
        { "id": "api-place", "cells": ["place(column, row)", "block", "Set one-based grid coordinates."] },
        { "id": "api-flow", "cells": ["flow()", "block", "Return to CSS automatic order."] },
        { "cells": ["describe(options?)", "definition", "Serialize this live block into a registerable definition for the built-in html adapter; options.url names the page it lives on."] },
        { "cells": ["remove()", "true", "Remove the block and release its layout."] }
      ]
    },
    "reference-definition-create": {
      "title": "definitions + adapters",
      "intro": "Definitions describe reusable content. Register definitions and their lifecycle adapters on the shared system.",
      "code": [
        "const definition = {",
        "  id: \"block-note\",",
        "  adapter: \"note\",",
        "  label: \"note\",",
        "  medium: \"html\",",
        "  category: \"text\",",
        "  description: \"a small note\",",
        "  defaults: { text: \"hello\" },",
        "  attributes: [],",
        "  requires: []",
        "};"
      ],
      "headers": ["method", "returns", "purpose"],
      "rows": [
        { "id": "api-register", "cells": ["register(definition, options?)", "blocks", "Register a reusable block definition."] },
        { "id": "api-register-adapter", "cells": ["registerAdapter(id, adapter, options?)", "blocks", "Register a lifecycle adapter."] },
        { "cells": ["definition.url", "string", "Page the block lives on; address() prefers it over the catalogUrl."] },
        { "cells": ["adapter \"html\"", "built-in", "Mounts and snippets trusted definition.markup — the same trust boundary as add(content). Replace it with registerAdapter(\"html\", adapter, { replace: true })."] },
        { "cells": ["listAdapters()", "string[]", "List registered adapter ids, starting with the built-in html adapter."] },
        { "cells": ["list(filters?)", "definition[]", "Filter definitions by query, adapter, medium or category."] },
        { "cells": ["get(id)", "definition | null", "Read one registered definition."] }
      ]
    },
    "reference-adapter-methods": {
      "title": "adapter lifecycle methods",
