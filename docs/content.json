      "body": "variant: \"inverse\""
    },
    "manual-colors": {
      "title": "07 / set a color",
      "intro": "Set one block color directly. Any valid CSS color can define its border, titlebar and hover frame; the content surface stays neutral.",
      "contract": "api.html#block-controller",
      "layout": {
        "place": [1, 37],
        "span": [2, 2]
      }
    },
    "manual-colors-code": {
      "title": "color code",
      "code": [
        "const colors = [\"cyan\", \"magenta\", \"yellow\"];",
        "",
        "for (const color of colors) {",
        "  const block = blocks.add(content, {",
        "    title: color,",
        "    variant: \"regular\"",
        "  });",
        "  block.color = color;",
        "}"
      ],
      "layout": {
        "place": [3, 37],
        "span": [4, 2]
      }
    },
    "manual-color-cyan": {
      "title": "cyan",
      "eyebrow": "your content",
