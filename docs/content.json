  "manual": {
    "manual-eli10": {
      "title": "00 / ELI10",
      "eyebrow": "three things, in order",
      "statement": "Container. Blocks. One block.",
      "body": "A container is an empty div. blocks is the system connected to that div. A block is one individual box inside it.",
      "steps": [
        "Add an empty <div id=\"blocks-field\"></div>.",
        "Create blocks and connect it to that div with blocks.attach(...).",
        "Add one individual block with blocks.add(...)."
      ]
    },
    "manual-start": {
      "title": "01 / start the system",
      "intro": "Load the fixed v0.1.1 release, then attach the system before adding content. setGrid(6, 4) creates six columns and four rows.",
      "code": [
        "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.1.1/blocks.system.css\">",
        "<div id=\"blocks-field\"></div>",
        "",
        "<script type=\"module\">",
        "import { createBlocksSystem } from \"https://cdn.jsdelivr.net/gh/seb-prjcts-be/blocks.system@v0.1.1/blocks.system.mjs\";",
        "",
        "const blocks = createBlocksSystem({",
        "  snap: true,",
        "  variant: \"regular\",",
        "  blockDefaults: {",
        "    menu: { minimize: true, close: true }",
        "  }",
        "});",
        "",
        "blocks.attach(\"#blocks-field\");",
        "blocks.setGrid(6, 4);"
      ]
    },
    "manual-content-html": {
      "title": "content / trusted html",
      "eyebrow": "01 / statement",
      "statement": "Structure makes movement visible.",
      "footer": "type · interval · contrast"
    },
    "manual-content-object": {
      "title": "content / object",
      "caption": "02 / direction",
      "alt": "Black-and-white skatepark with converging concrete ramps, painted lines and a metal rail."
    },
    "manual-content-factory": {
      "title": "content / factory",
      "eyebrow": "03 / live",
      "states": ["structure", "contrast", "rhythm", "space"],
      "action": "next state"
    },
    "manual-finish": {
      "title": "02 / add the block",
      "intro": "blocks.add() returns the block controller. Its id must be unique lowercase kebab-case.",
      "code": [
        "const block = blocks.add(content, {",
        "  id: \"block-hello\",",
        "  title: \"hello\"",
        "});",
        "</script>"
      ]
    },
    "manual-result-regular": {
      "title": "result / regular",
