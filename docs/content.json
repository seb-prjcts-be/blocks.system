    "reference-errors": {
      "title": "06 / errors and defaults",
      "eyebrow": "fail early / catch only recoverable errors",
      "statement": "invalid ids, missing fields, grid overflow, overlap, duplicate registration, unknown definitions and incomplete adapters throw.",
      "details": "Defaults: drag on · snap off · no automatic menu · 1 × 1 grid · random monochrome variant · no attached field · English labels unless the document language is Dutch. Creation options can set shared initial behavior."
    }
  }
}
